{
  "name": "inspeccion-restauradores",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "crear-admin": "node scripts/crear-admin.mjs",
    "pages:dev": "wrangler pages dev dist --port 8788 --compatibility-date=2026-06-01 --d1 DB=restauradores-local --r2 ARCHIVOS",
    "tiempo-real:deploy": "wrangler deploy --config workers/tiempo-real/wrangler.toml",
    "tiempo-real:dev": "wrangler dev --config workers/tiempo-real/wrangler.toml --port 8790",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"functions/**/*.ts\" \"tests/**/*.ts\" \"workers/**/*.ts\"",
    "verificar": "tsc -b && eslint . && vitest run && vite build"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.5",
    "jspdf": "2.5.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@eslint/js": "^9.37.0",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "postcss": "8.5.31",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "6.4.5",
    "vite-plugin-pwa": "0.21.2",
    "vitest": "3.2.7",
    "wrangler": "4.100.0"
  }
}
